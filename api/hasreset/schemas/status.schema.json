{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Runway reset event feed",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastSuccessfulCheckAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "degraded"
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "configuration_error",
            "request_failed",
            "invalid_response",
            "uncited_source"
          ]
        }
      },
      "required": [
        "status",
        "errorCode"
      ]
    },
    "events": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "reset_completed",
              "reset_scheduled",
              "banked_reset",
              "limit_increase",
              "uncertain"
            ]
          },
          "announcedAt": {
            "type": "string",
            "format": "date-time"
          },
          "effectiveAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "plans": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "windows": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "plans",
              "windows"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "handle": {
                "const": "thsottiaux"
              },
              "postId": {
                "type": "string",
                "pattern": "^[0-9]{1,30}$"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "handle",
              "postId",
              "url"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {
            "type": "string",
            "enum": [
              "Explicit Codex quota reset announcement.",
              "Explicit Codex quota reset schedule.",
              "Banked reset announcement; not a completed reset.",
              "Quota limit increase announcement; not a reset.",
              "Relevant announcement could not be classified safely."
            ]
          }
        },
        "required": [
          "kind",
          "announcedAt",
          "effectiveAt",
          "scope",
          "source",
          "confidence",
          "rationale"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "lastSuccessfulCheckAt",
    "monitor",
    "events"
  ]
}
