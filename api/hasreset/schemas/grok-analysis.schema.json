{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HasReset Grok analysis",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "reset_completed",
              "reset_scheduled",
              "banked_reset",
              "limit_increase",
              "uncertain"
            ]
          },
          "announcedAt": {
            "type": "string",
            "format": "date-time"
          },
          "effectiveAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "plans": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "enum": [
                "all",
                "free",
                "plus",
                "pro",
                "team",
                "business",
                "enterprise",
                "unknown"
              ]
            }
          },
          "windows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "weekly",
                "five_hour",
                "unknown"
              ]
            }
          },
          "postId": {
            "type": "string",
            "pattern": "^[0-9]{1,30}$"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "kind",
          "announcedAt",
          "effectiveAt",
          "plans",
          "windows",
          "postId",
          "sourceUrl",
          "confidence"
        ]
      }
    }
  },
  "required": [
    "events"
  ]
}
